{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://fome-de-amor-admin.vercel.app"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://fome-de-amor-admin.vercel.app/:path*"
    },
    {
      "source": "/runday",
      "destination": "/runday.html"
    },
    {
      "source": "/runday/pagamento",
      "destination": "/runday-pagamento.html"
    },
    {
      "source": "/runday/inscritos",
      "destination": "/runday-inscritos.html"
    },
    {
      "source": "/runday/regulamento",
      "destination": "/runday-regulamento.html"
    },
    {
      "source": "/runday/assessoria/:token",
      "destination": "/runday-assessoria.html"
    }
  ],
  "headers": [
    {
      "source": "/runday/inscritos",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/runday/assessoria/:token",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
